# Yerelde (localhost) boş bırakın — vite.config.ts'deki proxy /api'yi
# otomatik olarak http://localhost:4000'e yönlendirir.
#
# Vercel/Netlify gibi bir yere dağıttığınızda, backend'i ayrı bir adreste
# (Railway/Render/vb.) barındırıp buraya o adresi yazın:
# VITE_API_BASE_URL=https://sizin-backend-adresiniz.up.railway.app/api
VITE_API_BASE_URL=
