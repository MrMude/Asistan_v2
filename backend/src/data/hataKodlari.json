  {
    "id": "ST-001",
    "kod": "ST-001",
    "aciklama": "N'de aracı ittir — Anormal direnç var mı?"
  },
  {
    "id": "ST-002",
    "kod": "ST-002",
    "aciklama": "D'de gaz ver — Araç normal hızlanıyor mu? Sıkma hissi veya anormal se…"
  },
  {
    "id": "ST-003",
    "kod": "ST-003",
    "aciklama": "R'de gaz ver — Geri viteste normal hızlanıyor mu? Sıkma hissi veya an…"
  },
  {
    "id": "ST-004",
    "kod": "ST-004",
    "aciklama": "Dış aydınlatma — Kısa, uzun, selektör, park, sis, sol/sağ sinyal, dör…"
  },
  {
    "id": "ST-005",
    "kod": "ST-005",
    "aciklama": "Korna — Ses seviyesi ve çalışması normal mi?"
  },
  {
    "id": "ST-006",
    "kod": "ST-006",
    "aciklama": "Camlar — Tüm camlar açılıp kapanıyor mu? Takılma, yavaşlık veya ses v…"
  },
  {
    "id": "ST-007",
    "kod": "ST-007",
    "aciklama": "Merkezi kilit & kapılar — İçeriden ve anahtarla dışarıdan kilitle-aç.…"
  },
  {
    "id": "ST-008",
    "kod": "ST-008",
    "aciklama": "Aynalar & iç donanım — Aynalar, IP kapakları, emniyet kemeri kapaklar…"
  },
  {
    "id": "ST-009",
    "kod": "ST-009",
    "aciklama": "Emniyet kemerleri — Tokalar çalışıyor mu? Kemer düzgün sarıyor mu? Uy…"
  },
  {
    "id": "ST-010",
    "kod": "ST-010",
    "aciklama": "El freni (KRİTİK) — El frenini çek → hafif gaz ver → araç ilerlemeye …"
  },
  {
    "id": "ST-011",
    "kod": "ST-011",
    "aciklama": "Vites seçimi — P/R/N/D geçişlerinde gecikme, yanlış gösterim veya kar…"
  },
  {
    "id": "ST-012",
    "kod": "ST-012",
    "aciklama": "Ana ekran / menüler — Tüm menülerde düğmelere tek tek bas. Donma, sıf…"
  },
  {
    "id": "ST-013",
    "kod": "ST-013",
    "aciklama": "Geri görüş kamerası — R'ye alınca görüntü geliyor mu? Görüntü temiz m…"
  },
  {
    "id": "ST-014",
    "kod": "ST-014",
    "aciklama": "Klima & havalandırma — Fan 1-2-3, yüze/cama üfleme, iç hava dolaşımı,…"
  },
  {
    "id": "ST-015",
    "kod": "ST-015",
    "aciklama": "Odometre — Sürüş öncesi değeri not et. Sürüş sonrası doğru sayıyor mu…"
  },
  {
    "id": "ST-016",
    "kod": "ST-016",
    "aciklama": "Düşük hız — 500m, 0→30 km/s. Titreme, silkelenme, anormal ses, çekişt…"
  },
  {
    "id": "ST-017",
    "kod": "ST-017",
    "aciklama": "Fren — 30→0 x5 (~300m). Her frenlemede sağa/sola ekstrem çekme var mı…"
  },
  {
    "id": "ST-018",
    "kod": "ST-018",
    "aciklama": "Sürekli frenleme — Dur-kalk min. 20x (~600m). Pedal sertleşmesi/boşal…"
  },
  {
    "id": "ST-019",
    "kod": "ST-019",
    "aciklama": "Fren — 50→0 x5 (~400m). Her frenlemede sağa/sola ekstrem çekme var mı…"
  },
  {
    "id": "ST-020",
    "kod": "ST-020",
    "aciklama": "Fren — 90→0 / 80→0 / 70→0 (~500m). Her frenlemede sağa/sola ekstrem ç…"
  },
  {
    "id": "ST-021",
    "kod": "ST-021",
    "aciklama": "Son hıza ulaşma (~600m) — ECO modda 90 km/s'ye ulaşıyor mu? SPORT mod…"
  },
  {
    "id": "ST-022",
    "kod": "ST-022",
    "aciklama": "Yokuş çıkış + iniş (~400m) — Çıkışta geri kaçırma, çekiş düşmesi var …"
  },
  {
    "id": "ST-023",
    "kod": "ST-023",
    "aciklama": "Yokuş el freni (KRİTİK) — Yokuşta en az 6 kez kaydır-tut. El freni çe…"
  },
  {
    "id": "ST-024",
    "kod": "ST-024",
    "aciklama": "N'de yokuş fren testi (~100m) — Yokuş aşağı N'de fren yap, bırak. Ara…"
  },
  {
    "id": "ST-025",
    "kod": "ST-025",
    "aciklama": "Düşük hız fren genel — 30→0 testlerinde tutarlı performans sağlandı m…"
  },
  {
    "id": "ST-026",
    "kod": "ST-026",
    "aciklama": "Orta hız fren genel — 50→0 testlerinde tutarlı performans sağlandı mı?"
  },
  {
    "id": "ST-027",
    "kod": "ST-027",
    "aciklama": "Yüksek hız fren genel — 90/80/70→0 testlerinde tutarlı performans sağ…"
  },
  {
    "id": "ST-028",
    "kod": "ST-028",
    "aciklama": "FRENLERDE SIKMA VAR MI? (KRİTİK) — Anormal direnç, tek taraflı ısınma…"
  },
  {
    "id": "ST-029",
    "kod": "ST-029",
    "aciklama": "Nihai Fren Onayı — Tüm fren testleri tamamlandı, anormal bulgu yok mu?"
  },
  {
    "id": "ST-030",
    "kod": "ST-030",
    "aciklama": "Rot ayarı — Düz/eğimsiz yolda direksiyonu bırak. Araç sola veya sağa …"
  },
  {
    "id": "ST-031",
    "kod": "ST-031",
    "aciklama": "Direksiyon merkezi — Düz gidişte direksiyon tam ortada mı? Belirgin s…"
  },
  {
    "id": "ST-032",
    "kod": "ST-032",
    "aciklama": "Yüksek hızda kararlılık — 70-90 km/s'de araç düz gidiyor mu? Çekme ve…"
  },
  {
    "id": "ST-033",
    "kod": "ST-033",
    "aciklama": "Sol ön disk — Elini yaklaştır (dokunma). Diğer disklere kıyasla belir…"
  },
  {
    "id": "ST-034",
    "kod": "ST-034",
    "aciklama": "Sağ ön disk — Aynı kontrol. Belirgin şekilde sıcak mı?"
  },
  {
    "id": "ST-035",
    "kod": "ST-035",
    "aciklama": "Sol arka disk — Aynı kontrol. Belirgin şekilde sıcak mı?"
  },
  {
    "id": "ST-036",
    "kod": "ST-036",
    "aciklama": "Sağ arka disk — Aynı kontrol. Belirgin şekilde sıcak mı?"
  },
  {
    "id": "ST-037",
    "kod": "ST-037",
    "aciklama": "N'de aracı ittir — Soğuk teste kıyasla artan direnç var mı? Isınma il…"
  },
  {
    "id": "ST-038",
    "kod": "ST-038",
    "aciklama": "Kapı / Kaput ayarı — Görsel kontrol. Fotoğraf ilet."
  },
  {
    "id": "ST-039",
    "kod": "ST-039",
    "aciklama": "Boya kalitesi — Görsel kontrol. Fotoğraf ilet."
  },
  {
    "id": "ST-040",
    "kod": "ST-040",
    "aciklama": "Trim & Bagaj — İç trim, dış trim düzgün mü? Bagaj yüksekliği doğru mu?"
  },
  {
    "id": "ST-041",
    "kod": "ST-041",
    "aciklama": "Tam dönüş kontrolü — Düşük hızda tam sağ/sol manevra. Sürtme, vuruntu…"
  },
  {
    "id": "ST-042",
    "kod": "ST-042",
    "aciklama": "DTC / Diyagnostik tarama — Aktif veya geçmiş hata varsa kayıt altına …"
  },
  {
    "id": "ST-043",
    "kod": "ST-043",
    "aciklama": "Mühendis Nihai Onayı"
  },
